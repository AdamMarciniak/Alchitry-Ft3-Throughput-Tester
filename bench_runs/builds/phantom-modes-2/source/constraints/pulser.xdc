#=============================================================================
# Sonic transmit chain - MAX14866 mux daisy chain + MD1213 gate driver
#
# Header pin assignments (Alchitry Au V2, bank B).  Source of truth is
# host/pulser.acf - run that through Alchitry Labs to get the package pins.
#
#   B39  CLK            -> mux_clk     chain clock
#   B33  DOUT_READBACK  -> mux_dout    chain loopback (INPUT, unused)
#   B51  DRIVER_EN      -> pulse_oe    MD1213 OE
#   B53  CLR            -> mux_clr     chain clear, active high
#   B57  SIG_IN_POS     -> pulse_ina   MD1213 INA, active high
#   B59  SIG_IN_NEG     -> pulse_inb   MD1213 INB, ACTIVE LOW
#   B63  DIN            -> mux_din     chain data
#   B65  LE             -> mux_le      latch enable, ACTIVE LOW
#
# All eight are 3.3 V LVCMOS.  Idle levels out of reset are driven by
# tx_sequencer.v:  clk=0  din=0  le=1  clr=0(after the power-up pulse)
#                  ina=0  inb=1  oe=0
#
# NOTE: pulse_inb and mux_le idle HIGH.  If a bank pull is ever added to
# these nets, it must be PULLUP, not PULLDOWN - a pulldown on pulse_inb
# parks the pulser output at -HV.
#=============================================================================

#-----------------------------------------------------------------------------
# Package pins generated by Alchitry Labs from host/pulser.acf.
# Verified against au_ft.xdc: no collision with any of the 69 pins already
# assigned to the FT601 bus, the AFE5804, the DAC7554 or the board peripherals.
#-----------------------------------------------------------------------------
set_property PACKAGE_PIN P11 [get_ports mux_clk]    ;# B39
set_property PACKAGE_PIN K5  [get_ports mux_dout]   ;# B33
set_property PACKAGE_PIN M1  [get_ports pulse_oe]   ;# B51
set_property PACKAGE_PIN M2  [get_ports mux_clr]    ;# B53
set_property PACKAGE_PIN N2  [get_ports pulse_ina]  ;# B57
set_property PACKAGE_PIN N3  [get_ports pulse_inb]  ;# B59
set_property PACKAGE_PIN P3  [get_ports mux_din]    ;# B63
set_property PACKAGE_PIN P4  [get_ports mux_le]     ;# B65

#-----------------------------------------------------------------------------
# I/O standard
#-----------------------------------------------------------------------------
set_property IOSTANDARD LVCMOS33 [get_ports {mux_clk mux_din mux_le mux_clr}]
set_property IOSTANDARD LVCMOS33 [get_ports {pulse_ina pulse_inb pulse_oe}]
set_property IOSTANDARD LVCMOS33 [get_ports mux_dout]

#-----------------------------------------------------------------------------
# Drive strength / slew.
#
# MD1213 t_irf: INA, INB and OE REQUIRE input edges faster than 10 ns.  FAST
# slew and full drive, and keep the traces short.  OE must come from the same
# 3.3 V domain as the data inputs - it sets their logic threshold to V_OE/2.
#
# MAX14866 t_R / t_F: 50 ns max edge rate on CLK.  FAST slew here too; do not
# slew-limit the chain clock, and do not put a series RC on one device's clock
# and not the others (the hold budget across a daisy-chain hop is only 2 ns and
# is frequency independent).
#-----------------------------------------------------------------------------
set_property SLEW  FAST [get_ports {pulse_ina pulse_inb pulse_oe}]
set_property DRIVE 12   [get_ports {pulse_ina pulse_inb pulse_oe}]

set_property SLEW  FAST [get_ports {mux_clk mux_din mux_le mux_clr}]
set_property DRIVE 12   [get_ports {mux_clk mux_din mux_le mux_clr}]

#-----------------------------------------------------------------------------
# Timing.  Nothing on this interface is source-synchronous to an external
# clock: mux_clk is generated as data from a register in the clk_100 domain,
# and mux_dout is resynchronised with a two-stage synchroniser inside
# tx_sequencer.  There is nothing for STA to check at the pins.
#-----------------------------------------------------------------------------
set_false_path -to   [get_ports {mux_clk mux_din mux_le mux_clr}]
set_false_path -to   [get_ports {pulse_ina pulse_inb pulse_oe}]
set_false_path -from [get_ports mux_dout]
